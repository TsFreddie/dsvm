{
  "name": "dsvm-desktop",
  "version": "0.1.0",
  "description": "dsvm desktop: NW.js wrapper that embeds the dsh web UI served by `dsvm service`",
  "main": "main.js",
  "window": {
    "title": "DeepSeek Harness (dsvm)",
    "width": 1280,
    "height": 860,
    "min_width": 800,
    "min_height": 600,
    "icon": "icon.png",
    "show_in_taskbar": true,
    "show": true
  },
  "content_capabilities": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*",
      "http://[::1]/*",
      "http://0.0.0.0/*",
      "http://[::]/*",
      "https://127.0.0.1/*",
      "https://localhost/*",
      "https://[::1]/*"
    ],
    "permissions": ["clipboardRead", "clipboardWrite", "unlimitedStorage"]
  },
  "chromium-args": "--test-type --ozone-platform-hint=auto --enable-features=UseOzonePlatform,WaylandWindowDecorations --enable-wayland-ime --wayland-text-input-version=3",
  "nodejs": true,
  "single-instance": true
}
